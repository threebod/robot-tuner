require_text("${config}" "#define HOST_DEBUG_MODE 1")
set(pid_stub "${CMAKE_CURRENT_LIST_DIR}/stubs/task12/pid.h")
set(params_h "${firmware_dir}/host_protocol/host_params.h")
require_text("${pid_stub}" "HOST_PID_PROFILE_T_DEFINED")
require_text("${params_h}" "HOST_PID_PROFILE_T_DEFINED")
require_text("${project}" "..\\host_protocol")
require_text("${project}" "<GroupName>host_protocol</GroupName>")
file(READ "${project}" project_content)
string(REGEX MATCHALL "<FilePath>..\\\\host_protocol\\\\(host_uart3|host_time|host_debug)\\.(c|h)</FilePath>" project_entries "${project_content}")
list(LENGTH project_entries entry_count)
if(NOT entry_count EQUAL 6)
    message(FATAL_ERROR "expected six Task 12 project entries, got ${entry_count}")
endif()
set(host_protocol_files
    host_config.h host_crc16.c host_crc16.h host_frame.c host_frame.h
    host_link.c host_link.h host_params.c host_params.h host_safety.c
    host_safety.h host_commands.c host_commands.h host_uart3.c host_uart3.h
    host_time.c host_time.h host_debug.c host_debug.h)
foreach(name IN LISTS host_protocol_files)
    string(REGEX MATCHALL "<FilePath>..\\\\host_protocol\\\\${name}</FilePath>" matches "${project_content}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "expected exactly one Keil entry for ${name}, got ${count}")
    endif()
endforeach()
