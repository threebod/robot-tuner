set(upper_dir "${CMAKE_CURRENT_LIST_DIR}/..")
set(firmware_dir "${upper_dir}/../yyb_stm32")

function(require_file path)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "missing Task 12 file: ${path}")
    endif()
endfunction()

function(require_text path needle)
    file(READ "${path}" content)
    string(FIND "${content}" "${needle}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "missing '${needle}' in ${path}")
    endif()
endfunction()

set(debug "${firmware_dir}/host_protocol/host_debug.c")
set(safety "${firmware_dir}/host_protocol/host_safety.c")
set(commands "${firmware_dir}/host_protocol/host_commands.c")
set(main_c "${firmware_dir}/USER/main.c")
set(pwm "${firmware_dir}/Hardware/PWM.c")
set(pwm_h "${firmware_dir}/Hardware/PWM.h")
set(uart5 "${firmware_dir}/lanya/usart5.c")
set(project "${firmware_dir}/USER/Template.uvprojx")

foreach(name host_uart3.h host_uart3.c host_time.h host_time.c host_debug.h host_debug.c
             host_runtime.h host_runtime.c)
    require_file("${firmware_dir}/host_protocol/${name}")
endforeach()
require_text("${safety}" "PWM_StopAll();")
require_text("${safety}" "Emm_V5_Stop_Now(address, false);")
require_text("${pwm}" "void PWM_StopAll(void)")
require_text("${pwm}" "void set_zhuashou_Angle_NonBlocking")
require_text("${pwm_h}" "set_zhuashou_Angle_NonBlocking")
require_text("${debug}" "set_zhuashou_Angle_NonBlocking")
file(READ "${debug}" debug_content)
string(FIND "${debug_content}" "set_zhuashou_he(" blocking_close)
string(FIND "${debug_content}" "set_zhuashou_kai(" blocking_open)
if(NOT blocking_close EQUAL -1 OR NOT blocking_open EQUAL -1)
    message(FATAL_ERROR "protocol debug path calls blocking gripper API")
endif()
require_text("${uart5}" "UART5_TX_QUEUE_SIZE")
require_text("${uart5}" "USART_IT_TXE")
require_text("${uart5}" "UART5_QueueTx")
require_text("${uart5}" "__get_PRIMASK")
require_text("${uart5}" "USART_ITConfig(UART5, USART_IT_TXE, ENABLE)")
file(READ "${uart5}" uart5_content)
string(FIND "${uart5_content}" "while (USART_GetFlagStatus(UART5, USART_FLAG_TC)" polling_tc)
if(NOT polling_tc EQUAL -1)
    message(FATAL_ERROR "UART5 still polls TC")
endif()
string(FIND "${uart5_content}" "USART_ITConfig(UART5, USART_IT_RXNE, DISABLE)" rx_disable)
if(NOT rx_disable EQUAL -1)
    message(FATAL_ERROR "UART5 disables RXNE in ISR")
endif()
